<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
<title>Movie Watchlist</title>
<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@700&family=Quicksand:wght@400;600&display=swap" rel="stylesheet" />
<style>
  /* Reset & base */
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: #121212;
    color: #eee;
    font-family: 'Quicksand', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100vw;
    max-width: 350px;
    padding: 1rem 1rem 2rem;
    position: relative;
    z-index: 0;
    min-height: 100vh;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  /* Animated background */
  body::before {
    content: "";
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: -1;
    background: radial-gradient(circle at center, #1db954 0%, #0a1d12 70%);
    background-size: 400% 400%;
    animation: gradientShift 15s ease infinite;
  }
  @keyframes gradientShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  header {
    font-family: 'Poppins', sans-serif;
    font-size: 1.9rem;
    font-weight: 700;
    margin-bottom: 0.3rem;
    user-select: none;
    text-shadow:
      0 0 5px #1db954,
      0 0 10px #1db954,
      0 0 15px #1db954;
  }
  .subtitle {
    font-family: 'Poppins', sans-serif;
    font-size: 1.05rem;
    color: #bbb;
    margin-bottom: 1.2rem;
    user-select: none;
    text-align: center;
    text-shadow:
      0 0 3px #0f6b31;
  }

  .input-section {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .input-row {
    display: flex;
    gap: 0.5rem;
  }
  .input-section input[type="text"] {
    flex-grow: 1;
    padding: 0.75rem 1.1rem;
    font-size: 1.1rem;
    border-radius: 25px;
    border: 2px solid #1db954;
    outline: none;
    background: #222;
    color: #eee;
    transition: background-color 0.3s ease, border-color 0.3s ease;
    box-shadow: inset 0 1px 3px #145214;
    font-family: 'Quicksand', sans-serif;
    font-weight: 400;
  }
  .input-section input[type="text"]::placeholder {
    color: #7fbf7f;
  }
  .input-section input[type="text"]:focus {
    background: #1a361a;
    border-color: #13a347;
    box-shadow: 0 0 8px #1db954, inset 0 1px 3px #145214;
  }
  .input-section button {
    background: linear-gradient(135deg, #3a7bd5, #00d2ff);
    border: none;
    border-radius: 25px;
    padding: 0.7rem 1.7rem;
    font-weight: 700;
    color: #121212;
    font-size: 1.2rem;
    cursor: pointer;
    transition: background 0.4s ease;
    box-shadow: 0 6px 9px rgba(0, 136, 255, 0.7);
    align-self: flex-end;
    filter: drop-shadow(0 0 6px #00bfff);
    font-family: 'Quicksand', sans-serif;
  }
  .input-section button:active,
  .input-section button:hover {
    background: linear-gradient(135deg, #0057ff, #00aaff);
    box-shadow: 0 8px 14px rgba(0, 102, 204, 0.9);
    filter: drop-shadow(0 0 12px #008cff);
  }

  .list-container {
    width: 100%;
    background: linear-gradient(135deg, #0f4515, #1e621f);
    border-radius: 18px;
    padding: 2.3rem 2rem 2.7rem;
    box-shadow: 0 12px 25px rgba(0,0,0,0.9), inset 0 0 18px #0e330f;
    margin-bottom: 1.8rem;
    transition: box-shadow 0.3s ease;
    font-family: 'Quicksand', sans-serif;
  }
  .list-container:hover {
    box-shadow: 0 14px 30px rgba(0,0,0,1), inset 0 0 22px #13a347;
  }
  .list-container h2 {
    margin: 0 0 1rem 0;
    font-weight: 700;
    font-size: 1.7rem;
    color: #d0f6bb;
    text-shadow: 0 0 10px #8afc5d;
    user-select: none;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Common styles for both lists */
  li {
    background: linear-gradient(90deg, #1a3b10, #245219);
    margin-bottom: 1.2rem;
    border-radius: 16px;
    display: flex;
    padding: 0.8rem 1.2rem;
    font-size: 1.25rem;
    user-select: none;
    box-shadow: 0 6px 15px rgba(0,0,0,0.8);
    transition: transform 0.2s ease, box-shadow 0.25s ease;
    overflow: hidden;
    align-items: center;
  }
  li:last-child {
    margin-bottom: 0;
  }
  li:hover, li:focus-within {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(29,185,84,0.9);
  }
  .movie-image {
    width: 52px;
    height: 70px;
    border-radius: 10px;
    object-fit: cover;
    margin-right: 1.3rem;
    background: #356a0b;
    flex-shrink: 0;
    box-shadow: 0 0 16px #2abf41;
    transition: box-shadow 0.3s ease;
  }
  .movie-image:hover {
    box-shadow: 0 0 24px #31d84d;
  }
  .vertical-info {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    justify-content: center;
  }
  .movie-title {
    color: #c3f9a3;
    font-weight: 700;
    font-size: 1.4rem;
    text-shadow: 0 0 7px #1e7d21;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 0.6rem;
  }
  .movie-title.watched {
    text-decoration: line-through;
    color: #8ebc96;
    text-shadow: none;
    font-style: italic;
  }
  .button-row {
    display: flex;
    gap: 0.8rem;
  }

  /* Buttons shared styles */
  .btn {
    border: none;
    border-radius: 50px;
    padding: 0.4rem 1.2rem;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    user-select: none;
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
    flex-shrink: 0;
    box-shadow: 0 4px 9px rgba(0,0,0,0.5);
    font-family: 'Quicksand', sans-serif;
    white-space: nowrap;
  }
  .btn-watch {
    background-color: #2fcc44;
    color: #121212;
    box-shadow: 0 6px 15px #28ca41cc;
  }
  .btn-watch:hover,
  .btn-watch:focus,
  .btn-watch:active {
    background-color: #24a934;
    box-shadow: 0 9px 25px #1e8c2bcc;
    outline: none;
  }
  .btn-remove {
    background-color: #ff0047;
    color: white;
    box-shadow: 0 6px 15px #ff0047cc;
  }
  .btn-remove:hover,
  .btn-remove:focus,
  .btn-remove:active {
    background-color: #cc003a;
    box-shadow: 0 9px 25px #cc003acc;
    outline: none;
  }

  /* Scrollbar styles for webkit */
  ::-webkit-scrollbar {
    width: 7px;
  }
  ::-webkit-scrollbar-thumb {
    background: #1db954cc;
    border-radius: 4px;
  }
  ::-webkit-scrollbar-track {
    background: #121212;
  }

  /* Responsive for small devices */
  @media (max-width: 350px) {
    body {
      max-width: 100vw;
      padding: 1rem;
    }
    .input-section input[type="text"] {
      font-size: 1rem;
      padding: 0.65rem 1rem;
    }
    .input-section button {
      padding: 0.6rem 1.4rem;
      font-size: 1.1rem;
      align-self: flex-end;
      background: linear-gradient(135deg, #3a7bd5, #00d2ff);
      box-shadow: 0 6px 9px rgba(0, 136, 255, 0.7);
    }
    .input-section button:active,
    .input-section button:hover {
      background: linear-gradient(135deg, #0057ff, #00aaff);
      box-shadow: 0 8px 14px rgba(0, 102, 204, 0.9);
    }
    li {
      font-size: 1.15rem;
      padding: 0.75rem 1.2rem;
      margin-bottom: 1.2rem;
    }
    .movie-image {
      width: 44px;
      height: 58px;
      margin-right: 1rem;
    }
    .movie-title {
      font-size: 1.25rem;
      margin-bottom: 0.6rem;
    }
    .button-row {
      gap: 0.6rem;
    }
    .btn {
      padding: 0.35rem 1rem;
      font-size: 0.9rem;
    }
  }
</style>
</head>
<body>
<header>CineList</header>
<div class="subtitle">Add movies with title and image link - keep track easily!</div>

<div class="input-section" aria-label="Add movie to watchlist">
  <div class="input-row">
    <input type="text" id="movie-input" placeholder="Enter movie title..." autocomplete="off" aria-label="Movie title" />
  </div>
  <div class="input-row">
    <input type="text" id="image-input" placeholder="Enter image URL (optional)" autocomplete="off" aria-label="Movie image URL" />
  </div>
  <button id="add-btn" aria-label="Add movie to watchlist">Add</button>
</div>

<div class="list-container" id="watchlist-container" >
  <h2>To Watch</h2>
  <ul id="watchlist"></ul>
</div>

<div class="list-container" id="watchedlist-container" >
  <h2>Watched</h2>
  <ul id="watchedlist"></ul>
</div>

<script>
  // DOM elements
  const movieInput = document.getElementById('movie-input');
  const imageInput = document.getElementById('image-input');
  const addBtn = document.getElementById('add-btn');
  const watchlistUl = document.getElementById('watchlist');
  const watchedlistUl = document.getElementById('watchedlist');

  // Retrieve watchlists from localStorage, stored as arrays of objects { title, imageUrl }
  let watchlist = JSON.parse(localStorage.getItem('watchlist')) || [];
  let watchedlist = JSON.parse(localStorage.getItem('watchedlist')) || [];

  // Save lists to localStorage
  function saveLists() {
    localStorage.setItem('watchlist', JSON.stringify(watchlist));
    localStorage.setItem('watchedlist', JSON.stringify(watchedlist));
  }

  // Helper function to validate if a string looks like an URL (basic)
  function looksLikeUrl(str) {
    return /^https?:\/\/.+/.test(str);
  }

  // Render list items
  function render() {
    // Clear existing lists
    watchlistUl.innerHTML = '';
    watchedlistUl.innerHTML = '';

    // Render To Watch List
    if (watchlist.length === 0) {
      const emptyMsg = document.createElement('li');
      emptyMsg.textContent = "Your watchlist is empty.";
      emptyMsg.style.fontStyle = "italic";
      emptyMsg.style.color = "#777";
      watchlistUl.appendChild(emptyMsg);
    } else {
      watchlist.forEach((movie, idx) => {
        const li = createMovieListItem(movie, idx, false);
        watchlistUl.appendChild(li);
      });
    }

    // Render Watched List
    if (watchedlist.length === 0) {
      const emptyMsg = document.createElement('li');
      emptyMsg.textContent = "You haven't watched any movies yet.";
      emptyMsg.style.fontStyle = "italic";
      emptyMsg.style.color = "#777";
      watchedlistUl.appendChild(emptyMsg);
    } else {
      watchedlist.forEach((movie, idx) => {
        const li = createMovieListItem(movie, idx, true);
        watchedlistUl.appendChild(li);
      });
    }
  }

  // Create list item element for movie {title, imageUrl}
  function createMovieListItem(movie, index, watched) {
    const li = document.createElement('li');

    const infoDiv = document.createElement('div');
    infoDiv.className = 'movie-info';

    const img = document.createElement('img');
    img.className = 'movie-image';
    if (movie.imageUrl && looksLikeUrl(movie.imageUrl)) {
      img.src = movie.imageUrl;
      img.alt = `${movie.title} poster`;
      img.onerror = () => {
        img.src = 'https://via.placeholder.com/60x80?text=No+Image';
      };
    } else {
      img.src = 'https://via.placeholder.com/60x80?text=No+Image';
      img.alt = 'No image available';
    }
    infoDiv.appendChild(img);

    const verticalInfoDiv = document.createElement('div');
    verticalInfoDiv.className = 'vertical-info';

    const titleSpan = document.createElement('span');
    titleSpan.textContent = movie.title;
    titleSpan.className = 'movie-title';
    if (watched) {
      titleSpan.classList.add('watched');
    }
    verticalInfoDiv.appendChild(titleSpan);

    const buttonRow = document.createElement('div');
    buttonRow.className = 'button-row';

    const btnWatch = document.createElement('button');
    btnWatch.className = 'btn btn-watch';
    btnWatch.textContent = watched ? 'Undo' : 'Watched';
    btnWatch.title = watched ? 'Mark as to watch again' : 'Mark as watched';

    btnWatch.addEventListener('click', () => {
      if (watched) {
        watchedlist.splice(index, 1);
        watchlist.push(movie);
      } else {
        watchlist.splice(index, 1);
        watchedlist.push(movie);
      }
      saveLists();
      render();
    });

    const btnRemove = document.createElement('button');
    btnRemove.className = 'btn btn-remove';
    btnRemove.textContent = 'Remove';
    btnRemove.title = 'Remove from list';

    btnRemove.addEventListener('click', () => {
      if (watched) {
        watchedlist.splice(index, 1);
      } else {
        watchlist.splice(index, 1);
      }
      saveLists();
      render();
    });

    buttonRow.appendChild(btnWatch);
    buttonRow.appendChild(btnRemove);

    verticalInfoDiv.appendChild(buttonRow);

    infoDiv.appendChild(verticalInfoDiv);

    li.appendChild(infoDiv);

    li.style.flexDirection = 'row';
    li.style.padding = '0.8rem 1.2rem';
    li.style.fontSize = '1.25rem';
    infoDiv.style.alignItems = 'center';

    return li;
  }

  // Add new movie function
  function addMovie() {
    const newMovie = movieInput.value.trim();
    const newImageUrl = imageInput.value.trim();

    if (!newMovie) {
      alert('Please enter a movie title.');
      return;
    }
    const lowerNewMovie = newMovie.toLowerCase();
    const isDuplicate = watchlist.some(m => m.title.toLowerCase() === lowerNewMovie) ||
                        watchedlist.some(m => m.title.toLowerCase() === lowerNewMovie);
    if (isDuplicate) {
      alert('This movie is already in your watchlist or watched list.');
      movieInput.value = '';
      imageInput.value = '';
      return;
    }
    if (newImageUrl && !looksLikeUrl(newImageUrl)) {
      alert('Please enter a valid image URL or leave it empty.');
      return;
    }
    const movieObj = { title: newMovie, imageUrl: newImageUrl };
    watchlist.push(movieObj);
    saveLists();
    render();
    movieInput.value = '';
    imageInput.value = '';
    movieInput.focus();
  }

  addBtn.addEventListener('click', addMovie);
  movieInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && document.activeElement !== imageInput) {
      addMovie();
    }
  });
  imageInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      addMovie();
    }
  });

  render();
</script>
</body>
</html>
